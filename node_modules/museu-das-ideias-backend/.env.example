# ============================================
# MUSEU DAS IDEIAS ABANDONADAS - Backend
# Arquivo de Configuração de Variáveis de Ambiente
# ============================================

# Porta do servidor (padrão: 3001)
PORT=3001

# Ambiente de execução (development, production)
NODE_ENV=development

# Chave da API do Google Gemini
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_chave_api_aqui

# Configuracao SMTP para envio de e-mails de confirmacao
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
MAIL_FROM="Museu das Ideias Abandonadas <seu_email@gmail.com>"

# Supabase Configuration
SUPABASE_URL=sua_url_supabase_aqui
SUPABASE_ANON_KEY=sua_chave_anonima_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para .env
# 2. Substitua os valores pelos seus dados reais
# 3. Configure os dados SMTP e Supabase conforme necessário
# 4. Nunca commite o arquivo .env no Git!
# ============================================
